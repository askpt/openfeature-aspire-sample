          "expr": "sum by(feature_flag_result_variant) (rate(feature_flag_evaluation_success_total{feature_flag_key=\"simulate-error\"}[$__rate_interval]))",
          "legendFormat": "{{feature_flag_result_variant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
