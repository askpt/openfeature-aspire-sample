        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Error Traces",
      "description": "The 20 most recent API service traces with an error status, searched in Tempo with TraceQL (`{ status = error && resource.service.name = \"apiservice\" }`). Each row is a failed `/test/error` request while `simulate-error` serves `error`; open a trace to see the exception next to the `feature_flag.evaluation` span events that name the variants served to that request.\n\nEmpty while no request fails.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": "$traces_ds",
      "targets": [
        {
          "refId": "A",
          "datasource": "$traces_ds",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{ status = error && resource.service.name = \"apiservice\" }"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
