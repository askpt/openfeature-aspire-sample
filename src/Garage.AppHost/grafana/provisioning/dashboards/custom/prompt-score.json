    {
      "id": 11,
      "type": "bargauge",
      "title": "Score per Cent by Variant",
      "description": "Value for money: average score ÷ average cost in cents, per variant — the quality points bought for $0.01.\n\nCheap prompts rank high here even when their absolute quality is poor, so read it together with “Average Score by Variant” when choosing which variant to promote with the flag. Only variants currently receiving traffic appear.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": "$metrics_ds",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(feature_flag_result_variant) (rate(feature_flag_tracking_value_sum{feature_flag_tracking_event_name=\"prompt-score\"}[$__rate_interval])) / sum by(feature_flag_result_variant) (rate(feature_flag_tracking_value_count{feature_flag_tracking_event_name=\"prompt-score\"}[$__rate_interval]))) / ((sum by(feature_flag_result_variant) (rate(feature_flag_tracking_value_sum{feature_flag_tracking_event_name=\"prompt-cost\"}[$__rate_interval])) / sum by(feature_flag_result_variant) (rate(feature_flag_tracking_value_count{feature_flag_tracking_event_name=\"prompt-cost\"}[$__rate_interval]))) * 100)",
          "instant": true,
          "legendFormat": "{{feature_flag_result_variant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
