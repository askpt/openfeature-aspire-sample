{
  "id": null,
  "uid": "prompt-score",
  "title": "Prompt Score",
  "description": "Quality score and simulated cost reported through OpenFeature tracking for the `prompt-file` flag (score: unreliable 0, brief 3, casual 5, expert 10; cost rises in the same order). Driven by the k6-prompt-score load generator against GET /test/prompt-score.",
  "tags": [
    "openfeature",
    "feature-flags",
    "tracking",
    "lgtm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "refresh": "10s",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "metrics_ds",
        "label": "Metrics datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "refresh": 1
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
